def detect_drum_onsets(audio, sr):
    """
    Custom multi-band drum onset detection optimized for capturing closely spaced hits.
    """
    # Split the signal into frequency bands relevant for different drum components
    # Low (kick), mid (snare), high (hi-hats, cymbals)
    y_harmonic, y_percussive = librosa.effects.hpss(audio)
    
    # Get onsets from percussive content with extremely sensitive settings
    perc_onset_frames = librosa.onset.onset_detect(
        y=y_percussive,
        sr=sr,
        hop_length=128,      # Very small hop for high time precision
        delta=0.03,          # Extremely low threshold
        wait=0,              # No wait time
        pre_max=1,           # Minimal pre-max
        post_max=1,          # Minimal post-max
        pre_avg=1,           # Minimal pre-avg
        post_avg=1           # Minimal post-avg
    )
    
    # Get separate onset detection optimized for low frequencies (kicks)
    y_low = librosa.effects.preemphasis(audio, coef=0.98)  # Reduce low frequency content
    low_onset_frames = librosa.onset.onset_detect(
        y=y_low,
        sr=sr,
        hop_length=128,
        delta=0.08,
        wait=1
    )
    
    # Combine all detected onsets
    all_onset_frames = np.unique(np.concatenate([perc_onset_frames, low_onset_frames]))
    all_onset_frames.sort()
    
    # Convert frames to time
    onset_times = librosa.frames_to_time(all_onset_frames, sr=sr, hop_length=128)
    
    # Minimal filtering - only remove physically impossible onsets
    if len(onset_times) > 0:
        filtered_times = [onset_times[0]]
        for t in onset_times[1:]:
            # Extremely permissive - allow hits as close as 25ms
            if t - filtered_times[-1] >= 0.025:
                filtered_times.append(t)
        onset_times = np.array(filtered_times)
    
    # Check for onset at the beginning
    first_energy = np.mean(np.abs(audio[:int(0.05*sr)]))
    if first_energy > 0.05 and (len(onset_times) == 0 or onset_times[0] > 0.1):
        onset_times = np.insert(onset_times, 0, 0)
    
    return onset_times


def extract_drum_segments(audio, sr, onset_times, segment_duration=0.15):
    """
    Extract drum segments with adaptive duration - longer for isolated hits, shorter for rapid patterns.
    
    Args:
        audio: Audio signal
        sr: Sample rate
        onset_times: Array of onset timestamps in seconds
        segment_duration: Default duration of each segment in seconds
    """
    segments = []
    times = []
    
    # Normalize audio
    audio = librosa.util.normalize(audio)
    
    for i, onset_time in enumerate(onset_times):
        # Calculate start sample with minimal pre-roll
        start_sample = max(0, int(onset_time * sr) - int(0.005 * sr))  # 5ms pre-roll
        
        # Calculate segment duration based on next onset
        if i < len(onset_times) - 1:
            # Distance to next onset
            next_onset = onset_times[i+1]
            time_to_next = next_onset - onset_time
            
            # Adaptive segment duration strategy
            if time_to_next < 0.1:  # Very close hits (rapid pattern)
                # Short duration for very close hits
                duration = min(0.08, time_to_next * 0.7)
            elif time_to_next < 0.25:  # Moderately close hits
                # Medium duration
                duration = min(0.2, time_to_next * 0.8)
            else:  # Isolated hit
                # Longer duration to capture full decay, especially for kicks/snares
                # For isolated hits, use a longer segment duration (up to 0.5s)
                duration = min(0.5, time_to_next * 0.8)
        else:
            # For last onset, use longer duration (assume it's isolated)
            duration = 0.5  # Capture full decay for last hit
        
        # Ensure minimum duration of 0.03s
        duration = max(0.03, duration)
        
        # Calculate end sample
        end_sample = min(len(audio), start_sample + int(duration * sr))
        
        # Extract segment
        segment = audio[start_sample:end_sample]
        
        # Skip if segment is too short
        if len(segment) < int(0.02 * sr):  # At least 20ms
            continue
        
        # For isolated hits, don't truncate based on energy decay
        # For close hits, truncate to avoid capturing the next hit
        if i < len(onset_times) - 1 and onset_times[i+1] - onset_time < 0.2:
            # Only analyze energy decay for closely spaced hits
            if len(segment) > int(0.05 * sr):  # At least 50ms to analyze
                # Calculate energy over time in small windows
                frame_length = int(0.01 * sr)  # 10ms frames
                energy = []
                for j in range(0, len(segment) - frame_length, frame_length):
                    energy.append(np.mean(segment[j:j+frame_length]**2))
                
                # If energy drops significantly after peak, truncate the segment
                if len(energy) > 2:
                    peak_idx = np.argmax(energy)
                    if peak_idx < len(energy) - 1:
                        # Look for significant drop after peak
                        for j in range(peak_idx + 1, len(energy)):
                            if energy[j] < 0.3 * energy[peak_idx]:
                                # Truncate segment at this point
                                new_length = min(len(segment), (j + 1) * frame_length)
                                segment = segment[:new_length]
                                break
        
        # Apply fade in/out to prevent clicks
        fade_samples = int(0.003 * sr)  # 3ms fade
        if len(segment) > 2 * fade_samples:
            fade_in = np.linspace(0, 1, fade_samples)
            fade_out = np.linspace(1, 0, fade_samples)
            segment[:fade_samples] *= fade_in
            segment[-fade_samples:] *= fade_out
        
        segments.append(segment)
        times.append(onset_time)
    
    return segments, times


def filter_closely_spaced_onsets(onset_times, min_distance=0.08):
    """
    Smarter filtering for drum onsets allowing rapid hi-hat patterns.
    
    Uses energy and spectral characteristics to decide when to keep closely spaced onsets.
    """
    if len(onset_times) <= 1:
        return onset_times
        
    filtered_onsets = [onset_times[0]]
    
    for i in range(1, len(onset_times)):
        current = onset_times[i]
        previous = filtered_onsets[-1]
        time_diff = current - previous
        
        # Always keep onsets that are sufficiently spaced
        if time_diff >= min_distance:
            filtered_onsets.append(current)
        # For very close onsets, keep them if they appear to be different drum hits
        # This would ideally analyze the spectral content, but as a simplification,
        # we'll just keep every other close onset for now (typical for hi-hat patterns)
        elif time_diff >= 0.03:  # At least 30ms apart for physically possible hits
            filtered_onsets.append(current)
            
    return np.array(filtered_onsets)


def classify_drum_segments(segments, sr, model, use_ensemble=False, use_mel_model=False):
    """
