def detect_bpm(audio, sr):
    """
    Enhanced BPM detection optimized for drum patterns with multiple approaches.
    
    Args:
        audio: Audio signal
        sr: Sample rate
        
    Returns:
        estimated_bpm: Estimated BPM (beats per minute)
    """
    # First approach: Use onset strength + beat tracking
    onset_env = librosa.onset.onset_strength(y=audio, sr=sr, 
                                            hop_length=512,
                                            aggregate=np.median)
    
    # Get tempo using dynamic programming beat tracker
    tempo_dp, beats_dp = librosa.beat.beat_track(onset_envelope=onset_env, 
                                               sr=sr,
                                               start_bpm=60,
                                               tightness=100)
    
    # Second approach: Use percussive content for beat tracking
    y_harmonic, y_percussive = librosa.effects.hpss(audio)
    tempo_perc, beats_perc = librosa.beat.beat_track(y=y_percussive, 
                                                  sr=sr,
                                                  start_bpm=60,
                                                  tightness=100)
    
    # Third approach: Use tempo estimation via autocorrelation
    ac_tempo = librosa.beat.tempo(onset_envelope=onset_env, sr=sr)[0]
    
    # Fourth approach: Use percussive-enhanced onset strength
    perc_onset_env = librosa.onset.onset_strength(y=y_percussive, sr=sr)
    perc_ac_tempo = librosa.beat.tempo(onset_envelope=perc_onset_env, sr=sr)[0]
    
    # Collect all tempo estimates
    tempo_estimates = [tempo_dp, tempo_perc, ac_tempo, perc_ac_tempo]
    
    # Handle numpy arrays
    tempo_estimates = [t.item() if isinstance(t, np.ndarray) else t for t in tempo_estimates]

    
    # Get the most likely tempo by finding the median and closest estimate to it
    median_tempo = np.median(tempo_estimates)
    closest_idx = np.argmin([abs(t - median_tempo) for t in tempo_estimates])
    estimated_tempo = tempo_estimates[closest_idx]
    
    # Round to nearest integer
    estimated_bpm = round(estimated_tempo)
    
    # Check if tempo is likely half or double the actual tempo
    # Common issue with beat tracking on electronic music
    if estimated_bpm > 170:
        estimated_bpm = estimated_bpm / 2
    elif estimated_bpm < 70:
        estimated_bpm = estimated_bpm * 2
    
    # Final sanity check - if BPM is still unreasonable, default to 120
    if estimated_bpm < 60 or estimated_bpm > 200:
        estimated_bpm = 120
        
    return int(estimated_bpm)


def detect_time_signature(audio, sr, bpm):
    """
    Attempt to detect time signature from audio.
    
    Args:
        audio: Audio signal
        sr: Sample rate
        bpm: Detected tempo in BPM
        
    Returns:
        time_sig: Tuple of (numerator, denominator) representing time signature
    """
    # Default to 4/4 time
    default_time_sig = (4, 4)
    
    try:
        # Get beat frames
        onset_env = librosa.onset.onset_strength(y=audio, sr=sr)
        _, beats = librosa.beat.beat_track(onset_envelope=onset_env, sr=sr, bpm=bpm)
        
        # Convert to times
        beat_times = librosa.frames_to_time(beats, sr=sr)
        
        # Need at least 16 beats to attempt time signature detection
        if len(beat_times) < 16:
            return default_time_sig
            
        # Analyze intervals between beats to find patterns
        beat_intervals = np.diff(beat_times)
        
        # Calculate the median beat interval
        median_interval = np.median(beat_intervals)
        
        # Look for patterns in the first 16 beats
        beat_strengths = [onset_env[beat] for beat in beats[:16]]
        
        # If first beat is significantly stronger, might be 4/4 or 3/4
        if beat_strengths[0] > 1.5 * np.mean(beat_strengths[1:]):
            # Look for pattern of strong beats
            if len(beat_strengths) >= 12:
                # Check for 3/4 pattern (stronger beat every 3)
                three_pattern = beat_strengths[0::3]
                four_pattern = beat_strengths[0::4]
                
                three_mean = np.mean(three_pattern)
                four_mean = np.mean(four_pattern)
                
                other_beats_three = np.mean([beat_strengths[i] for i in range(len(beat_strengths)) if i % 3 != 0])
                other_beats_four = np.mean([beat_strengths[i] for i in range(len(beat_strengths)) if i % 4 != 0])
                
                # If strong beat occurs every 3 beats, likely 3/4
                if three_mean > four_mean and three_mean > 1.2 * other_beats_three:
                    return (3, 4)
        
        # Default to 4/4 if no clear pattern
        return default_time_sig
    
    except Exception as e:
        print(f"Error detecting time signature: {e}")
        return default_time_sig


def quantize_times(times, bpm, grid_resolution=16, humanize_factor=0.0, time_sig=(4, 4)):
    """
    Quantize onset times to a musical grid with optional humanization.
    
    Args:
        times: Array of onset timestamps in seconds
        bpm: Tempo in beats per minute
        grid_resolution: Grid resolution (4=quarter notes, 8=eighth notes, 16=16th notes, etc.)
        humanize_factor: Amount of original timing to preserve (0.0=full quantization, 1.0=no quantization)
        time_sig: Time signature as tuple (numerator, denominator)
    
    Returns:
        quantized_times: Array of quantized timestamps in seconds
    """
    if not times.size:
        return np.array([])
    
    # Calculate beat duration in seconds
    beat_duration = 60.0 / bpm
    
    # Calculate the grid step in seconds
    grid_step = (beat_duration * 4.0) / grid_resolution  # 4 beats per bar for 4/4
    
    # Create empty array for quantized times
    quantized_times = np.zeros_like(times)
    
    for i, time in enumerate(times):
        # Calculate the nearest grid position
        grid_position = round(time / grid_step)
        grid_time = grid_position * grid_step
        
        # Apply humanization if requested
        if humanize_factor > 0:
            # Blend between original and quantized times based on humanize factor
            quantized_times[i] = grid_time + humanize_factor * (time - grid_time)
        else:
            quantized_times[i] = grid_time
    
    return quantized_times


def get_grid_positions(times, bpm, grid_resolution=16, time_sig=(4, 4)):
    """
    Convert onset times to musical grid positions (bar.beat.tick format)
    
    Args:
        times: Array of timestamps in seconds
        bpm: Tempo in beats per minute
        grid_resolution: Ticks per quarter note
        time_sig: Time signature as tuple (numerator, denominator)
    
    Returns:
        positions: List of strings in "bar.beat.tick" format
    """
    beat_duration = 60.0 / bpm
    
    # How many ticks in a quarter note
    ticks_per_quarter = grid_resolution / 4
    
    # How many ticks in one beat (depends on time signature denominator)
    ticks_per_beat = ticks_per_quarter * (4 / time_sig[1])
    
    # How many beats in a bar
    beats_per_bar = time_sig[0]
    
    positions = []
    for time in times:
        # Convert time to ticks
        total_ticks = time / beat_duration * ticks_per_quarter
        
        # Calculate bar, beat, tick
        total_beats = total_ticks / ticks_per_beat
        bar = int(total_beats / beats_per_bar) + 1  # Bars start at 1
        beat_in_bar = int(total_beats % beats_per_bar) + 1  # Beats start at 1
        tick = int(total_ticks % ticks_per_beat)
        
        positions.append(f"{bar}.{beat_in_bar}.{tick}")
    
    return positions


def create_midi_file(onset_times, instruments, output_path, bpm=120.0, velocities=None, 
                    quantize=False, grid_resolution=16, humanize_factor=0.0, time_sig=(4, 4)):
    """
    Create a MIDI file from onset times and classified instruments with optional quantization.

    Args:
        onset_times: Array of onset timestamps in seconds
        instruments: List of classified instrument names
        output_path: Path to save the MIDI file
        bpm: Tempo in beats per minute
        velocities: Optional list of velocity values for each note
        quantize: Whether to quantize notes to a musical grid
        grid_resolution: Grid resolution for quantization (4=quarter, 8=eighth, 16=16th notes)
        humanize_factor: How much of original timing to preserve (0.0=full quantize, 1.0=no quantize)
        time_sig: Time signature as tuple (numerator, denominator)
    """
    # Create a PrettyMIDI object with the detected BPM
    midi = pretty_midi.PrettyMIDI(initial_tempo=bpm)

    # Create a drum instrument object
    drum_track = pretty_midi.Instrument(program=0, is_drum=True, name="Drums")

    # Map drum instruments to General MIDI drum map note numbers
    instrument_to_note = {
        "kick": 36,      # Bass Drum 1
        "snare": 38,     # Acoustic Snare
        "hi-hat": 42,    # Closed Hi-Hat
        "crash": 49,     # Crash Cymbal 1
        "ride": 51,      # Ride Cymbal 1
        "floor_tom": 41, # Low Floor Tom
        "rack_tom": 50   # High Tom
    }

    # Quantize onset times if requested
    if quantize:
        onset_times_array = np.array(onset_times)
        quantized_times = quantize_times(onset_times_array, bpm, grid_resolution, 
                                        humanize_factor, time_sig)
        # Get musical positions for logging/debugging
        grid_positions = get_grid_positions(quantized_times, bpm, grid_resolution, time_sig)
        timing_source = quantized_times
    else:
        timing_source = onset_times
        grid_positions = None

    # Add notes to the drum track
    for i, (time, instrument) in enumerate(zip(timing_source, instruments)):
        if instrument in instrument_to_note:
            note_number = instrument_to_note[instrument]
            
            # Use provided velocity or default to 100
            velocity = velocities[i] if velocities is not None else 100
            
            # Set duration to 0.1 seconds (or adjust as needed)
            note = pretty_midi.Note(
                velocity=velocity,
                pitch=note_number,
                start=time,
                end=time + 0.1  # Fixed note duration
            )
            drum_track.notes.append(note)

    # Add the drum track to the MIDI file
    midi.instruments.append(drum_track)

    # Write the MIDI file
    midi.write(output_path)
    
    return grid_positions


def convert_audio_to_midi(audio_path, output_midi_path, model, sr=22050, use_ensemble=False, 
                         quantize=False, grid_resolution=16, humanize_factor=0.0, 
                         time_sig=None, save_onsets=False, save_visualization=False,
                         output_dir=None):
    """
    Convert audio file to MIDI using drum classification with optional quantization.

    Args:
        audio_path: Path to the input audio file
        output_midi_path: Path to save the output MIDI file
        model: Trained CNN classifier model or ensemble
        sr: Sample rate for audio processing
        use_ensemble: Whether to use ensemble prediction mode
        quantize: Whether to quantize notes to a musical grid
        grid_resolution: Grid resolution (4=quarter, 8=eighth, 16=16th notes)
        humanize_factor: How much of original timing to preserve (0.0=full quantize, 1.0=no quantize)
        time_sig: Time signature as tuple (numerator, denominator). If None, will attempt detection
        save_onsets: Whether to save individual onset audio files for testing
        save_visualization: Whether to save visualization of detected onsets and classifications
        output_dir: Directory to save all output files
    """
    # If output directory is not specified, use the directory of output_midi_path
    if output_dir is None:
        output_dir = os.path.dirname(output_midi_path)
    
    # Create the output directory if it doesn't exist
    os.makedirs(output_dir, exist_ok=True)
    
    # If output_midi_path is just a filename without path, add the output directory
    if os.path.dirname(output_midi_path) == '':
        output_midi_path = os.path.join(output_dir, output_midi_path)
    
    # Load audio file
    audio, sr = librosa.load(audio_path, sr=sr, mono=True)

    # Detect BPM
    bpm = detect_bpm(audio, sr)
    
    # Detect time signature if not provided
    if time_sig is None:
        time_sig = detect_time_signature(audio, sr, bpm)
        print(f"Detected time signature: {time_sig[0]}/{time_sig[1]}")

    # Detect onsets
    onset_times = detect_drum_onsets(audio, sr)

    # Extract segments for each onset
    segments, onset_times = extract_drum_segments(audio, sr, onset_times)

    # Calculate segment energies for velocity
    velocities = []
    for segment in segments:
        # Calculate RMS energy and convert to MIDI velocity (0-127)
        energy = np.sqrt(np.mean(segment**2))
        # Scale to useful MIDI velocity range
        velocity = min(127, max(40, int(energy * 100 * 127)))
        velocities.append(velocity)

    # Classify each segment
    instruments = classify_drum_segments(segments, sr, model, use_ensemble=use_ensemble)

    # Save individual onset files if requested
    onset_dir = None
    if save_onsets:
        # Create directory based on input filename
        base_filename = os.path.splitext(os.path.basename(audio_path))[0]
        onset_dir = os.path.join(output_dir, f"{base_filename}_onsets")
        os.makedirs(onset_dir, exist_ok=True)
        
        # Save each onset
        for i, (segment, onset_time, instrument) in enumerate(zip(segments, onset_times, instruments)):
            # Format filename with onset time and detected instrument
            onset_file = os.path.join(onset_dir, f"onset_{i:03d}_{onset_time:.3f}s_{instrument}.wav")
            # Save as WAV file
            wavfile.write(onset_file, sr, (segment * 32767).astype(np.int16))
        
        print(f"Saved {len(segments)} onset files to {onset_dir}/")
    
    # Create visualization if requested
    if save_visualization:
        create_onset_visualization(audio_path, audio, sr, onset_times, instruments, velocities, bpm, output_dir=output_dir)

    # Create MIDI file with detected BPM and optional quantization
    grid_positions = create_midi_file(
        onset_times, instruments, output_midi_path, bpm=bpm, velocities=velocities,
        quantize=quantize, grid_resolution=grid_resolution, 
        humanize_factor=humanize_factor, time_sig=time_sig
    )
    
    # Analyze timing accuracy
    timing_analysis = analyze_timing_accuracy(onset_times, instruments, bpm, time_sig)

    # Prepare result info
    result = {
        "num_hits": len(onset_times),
        "detected_instruments": set(instruments),
        "output_path": output_midi_path,
        "detected_bpm": bpm,
        "time_signature": time_sig,
        "onset_files_dir": onset_dir if save_onsets else None,
        "timing_analysis": timing_analysis
    }
    
    # Add quantization info if applicable
    if quantize:
        result["quantization"] = {
            "grid_resolution": grid_resolution,
            "humanize_factor": humanize_factor,
            "time_signature": time_sig,
            "grid_positions": grid_positions
        }

    return result


def create_onset_visualization(audio_path, audio, sr, onset_times, instruments, velocities, bpm, output_dir=None):
    """
    Create visualization of detected onsets and classifications.
    
    Args:
        audio_path: Path to the audio file
        audio: Audio signal
        sr: Sample rate
        onset_times: Array of onset timestamps
        instruments: List of classified instruments
        velocities: List of velocity values
        bpm: Detected tempo in BPM
        output_dir: Directory to save the visualization
    """
    try:
        import matplotlib.pyplot as plt
        import matplotlib.patches as mpatches
        from matplotlib.colors import to_rgba
        
        # Create output filename
        base_filename = os.path.splitext(os.path.basename(audio_path))[0]
        
        if output_dir is None:
            output_dir = os.path.dirname(audio_path)
            
        os.makedirs(output_dir, exist_ok=True)
        output_image = os.path.join(output_dir, f"{base_filename}_analysis.png")
        
        # Set up the figure
        plt.figure(figsize=(15, 8))
        
        # Plot waveform
        plt.subplot(3, 1, 1)
        plt.plot(librosa.times_like(audio, sr=sr), audio, color='gray', alpha=0.5)
        plt.title(f"Waveform with Detected Onsets - BPM: {bpm}")
        plt.xlabel("Time (s)")
        plt.ylabel("Amplitude")
        
        # Color map for different instruments
        colors = {
            "kick": "#FF0000",      # Red
            "snare": "#00FF00",     # Green
            "hi-hat": "#0000FF",    # Blue
            "crash": "#FFFF00",     # Yellow
            "ride": "#FF00FF",      # Magenta
            "floor_tom": "#00FFFF", # Cyan
            "rack_tom": "#FF8000"   # Orange
        }
        
        # Plot onset markers with instrument colors
        for t, instrument, velocity in zip(onset_times, instruments, velocities):
            color = colors.get(instrument, "#808080")  # Default to gray if instrument not found
            alpha = min(1.0, velocity / 127)  # Opacity based on velocity
            plt.axvline(x=t, color=color, alpha=alpha, linewidth=2)
        
        # Create legend for instruments
        patches = [mpatches.Patch(color=color, label=instr) for instr, color in colors.items() 
                  if instr in set(instruments)]
        plt.legend(handles=patches, loc='upper right')
        
        # Plot spectrogram
        plt.subplot(3, 1, 2)
        D = librosa.amplitude_to_db(np.abs(librosa.stft(audio)), ref=np.max)
        librosa.display.specshow(D, sr=sr, x_axis='time', y_axis='hz')
        plt.colorbar(format='%+2.0f dB')
        plt.title("Spectrogram")
        
        # Plot onset detection function
        plt.subplot(3, 1, 3)
        onset_env = librosa.onset.onset_strength(y=audio, sr=sr)
        frames = np.arange(len(onset_env))
        t = librosa.frames_to_time(frames, sr=sr)
        plt.plot(t, onset_env, alpha=0.8, label='Onset strength')
        
        # Plot onset detection threshold (estimated)
        threshold = np.mean(onset_env) + 0.5 * np.std(onset_env)
        plt.axhline(y=threshold, color='r', linestyle='--', alpha=0.5, label='Threshold')
        
        # Mark detected onsets
        for t in onset_times:
            frame = librosa.time_to_frames(t, sr=sr)
            if 0 <= frame < len(onset_env):
                plt.plot(t, onset_env[frame], 'ro', markersize=8)
        
        # Plot grid lines at each beat based on detected tempo
        if bpm > 0:
            beat_time = 60.0 / bpm
            max_time = librosa.get_duration(y=audio, sr=sr)
            beat_times = np.arange(0, max_time, beat_time)
            for b in beat_times:
                plt.axvline(x=b, color='g', linestyle=':', alpha=0.4)
        
        plt.title("Onset Strength with Detected Onsets")
        plt.xlabel("Time (s)")
        plt.ylabel("Strength")
        plt.legend()
        
        # Tight layout and save figure
        plt.tight_layout()
        plt.savefig(output_image, dpi=150)
        plt.close()
        
        print(f"Visualization saved to {output_image}")
        
    except Exception as e:
        print(f"Error creating visualization: {e}")


def analyze_timing_accuracy(onset_times, instruments, bpm, time_sig=(4, 4)):
    """
    Analyze the timing accuracy of a drum performance.
    
    Args:
        onset_times: Array of onset timestamps in seconds
        instruments: List of instrument names for each onset
        bpm: Tempo in BPM
        time_sig: Time signature as tuple (numerator, denominator)
        
    Returns:
        timing_analysis: Dictionary with timing metrics
    """
    # Calculate beat duration
    beat_duration = 60.0 / bpm
    
    # Group onsets by instrument type
    instrument_groups = {}
    for i, (time, instrument) in enumerate(zip(onset_times, instruments)):
        if instrument not in instrument_groups:
            instrument_groups[instrument] = []
        instrument_groups[instrument].append(time)
    
    # Metrics to calculate
    metrics = {
        "overall": {
            "grid_deviation": 0.0,  # How far from perfect grid (0-100, lower is better)
            "consistency": 0.0,     # How consistent the timing is (0-100, higher is better)
            "rushing": 0.0,         # Tendency to play ahead (-100 to 100, 0 is neutral)
            "dragging": 0.0         # Tendency to play behind (-100 to 100, 0 is neutral)
        }
    }
    
    # Calculate grid deviations for each instrument
    for instrument, times in instrument_groups.items():
        # Create a perfect grid based on the time signature
        grid_times = []
        for time in times:
            # Find closest grid position (16th note resolution)
            grid_step = beat_duration / 4  # 16th note
            closest_grid = round(time / grid_step) * grid_step
            grid_times.append(closest_grid)
        
        # Calculate deviations from grid
        deviations = np.array([abs(a - b) for a, b in zip(times, grid_times)])
        
        # Calculate timing ahead/behind
        timing_direction = np.array([a - b for a, b in zip(times, grid_times)])
        
        # Only keep deviations smaller than a 16th note
        valid_deviations = deviations[deviations < beat_duration/4]
        valid_directions = timing_direction[abs(timing_direction) < beat_duration/4]
        
        if len(valid_deviations) > 0:
            # Convert to milliseconds for easier reading
            avg_deviation_ms = np.mean(valid_deviations) * 1000
            std_deviation_ms = np.std(valid_deviations) * 1000
            
            # Calculate metrics (0-100 scale)
            # Grid deviation: 0ms = 100 score, 50ms = 0 score
            grid_accuracy = max(0, 100 - (avg_deviation_ms * 2))
            
            # Consistency: 0ms std = 100 score, 25ms std = 0 score
            consistency = max(0, 100 - (std_deviation_ms * 4))
            
            # Rushing/dragging: Average ms ahead/behind grid (-20ms to +20ms maps to -100 to +100)
            avg_direction_ms = np.mean(valid_directions) * 1000
            rushing_score = min(100, max(-100, avg_direction_ms * -5))
            dragging_score = min(100, max(-100, avg_direction_ms * 5))
            
            # Store metrics for this instrument
            metrics[instrument] = {
                "grid_deviation": grid_accuracy,
                "consistency": consistency,
                "rushing": rushing_score if avg_direction_ms < 0 else 0.0,
                "dragging": dragging_score if avg_direction_ms > 0 else 0.0,
                "avg_deviation_ms": avg_deviation_ms,
                "std_deviation_ms": std_deviation_ms,
                "num_hits": len(times)
            }
            
            # Update overall metrics (weighted by hit count)
            for key in ["grid_deviation", "consistency"]:
                metrics["overall"][key] += metrics[instrument][key] * len(times)
            
            if avg_direction_ms < 0:
                metrics["overall"]["rushing"] += metrics[instrument]["rushing"] * len(times)
            else:
                metrics["overall"]["dragging"] += metrics[instrument]["dragging"] * len(times)
    
    # Calculate final overall scores
    total_hits = len(onset_times)
    if total_hits > 0:
        for key in ["grid_deviation", "consistency"]:
            metrics["overall"][key] /= total_hits
        
        # For rushing/dragging, only count the dominant tendency
        if abs(metrics["overall"]["rushing"]) > abs(metrics["overall"]["dragging"]):
            metrics["overall"]["dragging"] = 0
        else:
            metrics["overall"]["rushing"] = 0
    
    # Add a final timing score (weighted combination of grid accuracy and consistency)
    metrics["overall"]["timing_score"] = 0.6 * metrics["overall"]["grid_deviation"] + 0.4 * metrics["overall"]["consistency"]
    
    return metrics


