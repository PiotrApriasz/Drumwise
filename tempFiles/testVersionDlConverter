import os
import numpy as np
import torch
import librosa
import pretty_midi
import tempfile
from scipy.io import wavfile

from src.converters.conversion_utils import set_length, classify_instrument_dl_mel



def detect_drum_onsets(audio, sr):
    """
    Simplified onset detection with aggressive filtering of closely spaced onsets.
    """
    # Basic onset detection
    onset_frames = librosa.onset.onset_detect(
        y=audio,
        sr=sr,
        hop_length=512,
        delta=0.25,
        wait=2
    )

    # Convert frames to time
    onset_times = librosa.frames_to_time(onset_frames, sr=sr, hop_length=512)

    # Apply aggressive filtering to remove closely spaced onsets
    filtered_onset_times = filter_closely_spaced_onsets(onset_times, min_distance=0.15)

    # Check for onset at the beginning
    first_energy = np.mean(np.abs(audio[:int(0.05*sr)]))
    if first_energy > 0.05 and (len(filtered_onset_times) == 0 or filtered_onset_times[0] > 0.1):
        filtered_onset_times = np.insert(filtered_onset_times, 0, 0)

    return filtered_onset_times


def extract_drum_segments(audio, sr, onset_times, segment_duration=0.2):
    """
    Extract very short audio segments to focus only on the attack portion of each drum hit.

    Args:
        audio: Audio signal
        sr: Sample rate
        onset_times: Array of onset timestamps in seconds
        segment_duration: Duration of each segment in seconds (shortened to 0.2s)

    Returns:
        segments: List of audio segments
        times: List of onset times
    """
    segments = []
    times = []  # Keep original onset times for reference

    for onset_time in onset_times:
        # Calculate start and end sample indices
        # Start exactly at the onset time (no pre-roll)
        start_sample = int(onset_time * sr)
        end_sample = int(min(len(audio), start_sample + segment_duration * sr))

        # Skip if we're too close to the end of the file
        if end_sample - start_sample < 0.05 * sr:  # At least 50ms of audio
            continue

        # Extract segment
        segment = audio[start_sample:end_sample]
        segment = set_length(segment, int(segment_duration * sr))
        segments.append(segment)
        times.append(onset_time)

    return segments, times


def filter_closely_spaced_onsets(onset_times, min_distance=0.15):
    """
    Filter out onsets that are too close together, keeping only the stronger ones.

    Args:
        onset_times: Array of onset times in seconds
        min_distance: Minimum allowed distance between onsets in seconds

    Returns:
        filtered_onsets: Array of filtered onset times
    """
    if len(onset_times) <= 1:
        return onset_times

    # Sort onsets by time
    sorted_onsets = np.sort(onset_times)

    # Initialize list of onsets to keep
    filtered_onsets = [sorted_onsets[0]]

    # Filter out onsets that are too close to previously accepted onsets
    for i in range(1, len(sorted_onsets)):
        if sorted_onsets[i] - filtered_onsets[-1] >= min_distance:
            filtered_onsets.append(sorted_onsets[i])

    return np.array(filtered_onsets)


def classify_drum_segments(segments, sr, model, use_ensemble=False, use_mel_model=False):
    """
    Classify each drum segment.

    Args:
        segments: List of audio segments
        sr: Sample rate
        model: Trained CNN classifier model or ensemble
        use_ensemble: Whether to use ensemble prediction mode

    Returns:
        instruments: List of classified instrument names
    """
    instruments = []
    with tempfile.TemporaryDirectory() as temp_dir:
        for i, segment in enumerate(segments):
            temp_file = os.path.join(temp_dir, f"segment_{i}.wav")
            wavfile.write(temp_file, sr, (segment * 32767).astype(np.int16))
            instrument = classify_instrument_dl_mel(temp_file, model, use_ensemble=use_ensemble, use_mel_model=use_mel_model)
            instruments.append(instrument)

    return instruments


def detect_bpm(audio, sr):
    """
    Detect the BPM (tempo) from audio signal.
    
    Args:
        audio: Audio signal
        sr: Sample rate
        
    Returns:
        estimated_bpm: Estimated BPM (beats per minute)
    """
    # Use librosa's beat tracking to estimate tempo
    onset_env = librosa.onset.onset_strength(y=audio, sr=sr)
    tempo, _ = librosa.beat.beat_track(onset_envelope=onset_env, sr=sr)
    
    # Handle case where tempo is a numpy array
    if isinstance(tempo, np.ndarray):
        tempo = tempo.item()  # Convert single-element array to scalar
    
    # Round to nearest integer
    estimated_bpm = round(tempo)
    
    # Sanity check - if BPM is unreasonably low or high, default to 120
    if estimated_bpm < 60 or estimated_bpm > 200:
        estimated_bpm = 120
        
    return estimated_bpm


def create_midi_file(onset_times, instruments, output_path, bpm=120.0):
    """
    Create a MIDI file from onset times and classified instruments.

    Args:
        onset_times: Array of onset timestamps in seconds
        instruments: List of classified instrument names
        output_path: Path to save the MIDI file
        bpm: Tempo in beats per minute (default: 120.0)
    """
    # Create a PrettyMIDI object with the detected BPM
    midi = pretty_midi.PrettyMIDI(initial_tempo=bpm)

    # Create a drum instrument object
    drum_track = pretty_midi.Instrument(program=0, is_drum=True, name="Drums")

    # Map drum instruments to General MIDI drum map note numbers
    instrument_to_note = {
        "kick": 36,  # Bass Drum 1
        "snare": 38,  # Acoustic Snare
        "hi-hat": 42,  # Closed Hi-Hat
        "crash": 49,  # Crash Cymbal 1
        "ride": 51,  # Ride Cymbal 1
        "floor_tom": 41,  # Low Floor Tom
        "rack_tom": 50  # High Tom
    }

    # Add notes to the drum track
    for i, (onset_time, instrument) in enumerate(zip(onset_times, instruments)):
        if instrument in instrument_to_note:
            note_number = instrument_to_note[instrument]
            # Set duration to 0.1 seconds (or adjust as needed)
            note = pretty_midi.Note(
                velocity=100,
                pitch=note_number,
                start=onset_time,
                end=onset_time + 0.1  # Fixed note duration
            )
            drum_track.notes.append(note)

    # Add the drum track to the MIDI file
    midi.instruments.append(drum_track)

    # Write the MIDI file
    midi.write(output_path)


def convert_audio_to_midi(audio_path, output_midi_path, model, sr=22050, use_ensemble=False, use_mel_model=False, save_onsets=False):
    """
    Convert audio file to MIDI using drum classification.

    Args:
        audio_path: Path to the input audio file
        output_midi_path: Path to save the output MIDI file
        model: Trained CNN classifier model or ensemble
        sr: Sample rate for audio processing
        use_ensemble: Whether to use ensemble prediction mode
        use_mel_model: Whether to use mel-based model
        save_onsets: Whether to save individual onset audio files for testing
    """
    # Load audio file
    audio, sr = librosa.load(audio_path, sr=sr, mono=True)

    # Detect BPM
    bpm = detect_bpm(audio, sr)

    # Detect onsets
    onset_times = detect_drum_onsets(audio, sr)

    # Extract segments for each onset
    segments, onset_times = extract_drum_segments(audio, sr, onset_times)

    # Classify each segment
    instruments = classify_drum_segments(segments, sr, model, use_ensemble=use_ensemble, use_mel_model=use_mel_model)

    # Save individual onset files if requested
    if save_onsets:
        # Create directory based on input filename
        base_filename = os.path.splitext(os.path.basename(audio_path))[0]
        onset_dir = f"{base_filename}_onsets"
        os.makedirs(onset_dir, exist_ok=True)
        
        # Save each onset
        for i, (segment, onset_time, instrument) in enumerate(zip(segments, onset_times, instruments)):
            # Format filename with onset time and detected instrument
            onset_file = os.path.join(onset_dir, f"onset_{i:03d}_{onset_time:.3f}s_{instrument}.wav")
            # Save as WAV file
            wavfile.write(onset_file, sr, (segment * 32767).astype(np.int16))
        
        print(f"Saved {len(segments)} onset files to {onset_dir}/")

    # Create MIDI file with detected BPM
    create_midi_file(onset_times, instruments, output_midi_path, bpm=bpm)

    return {
        "num_hits": len(onset_times),
        "detected_instruments": set(instruments),
        "output_path": output_midi_path,
        "detected_bpm": bpm,
        "onset_files_dir": onset_dir if save_onsets else None
    }


